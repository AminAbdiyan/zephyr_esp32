  adc0: adc@3ff48800 {
   compatible = "espressif,esp32-adc";
   reg = <0x3ff48800 10>;
   clocks = <&clock 118>;
   interrupt-parent = <&intc>;
   unit = <1>;
   channel-count = <8>;
