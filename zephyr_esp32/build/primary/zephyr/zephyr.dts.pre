   reg = <0x3ff67000 0x1000>;
   interrupts = <50 0 0>;
   interrupt-parent = <&intc>;
   clocks = <&clock 103>;
   status = "disabled";
  };

  i2s0: i2s@3ff4f000 {
   compatible = "espressif,esp32-i2s";
   #address-cells = <1>;
